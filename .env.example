# Copy to .env and fill in real values for local development.
# In CI/CD these come from GitHub Actions secrets — never commit .env to git.

# --- PostgreSQL ---
POSTGRES_DB=schoolhub
POSTGRES_USER=schoolhub
POSTGRES_PASSWORD=changeme

# --- Backend ---
# Local dev (backend outside Docker): use localhost + mapped port 5433
# Inside Docker Compose: db hostname is "db", port 5432
DATABASE_URL=postgresql://schoolhub:changeme@localhost:5433/schoolhub
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
